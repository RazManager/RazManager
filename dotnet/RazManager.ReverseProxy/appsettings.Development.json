{
  "ReverseProxy": {
    "Routes": {
      "routeIdentity": {
        "ClusterId": "clusterIdentity",
        "Match": {
          "Hosts": [ "identity.razmanager.localhost" ]
        }
      },
      "routeAdmin": {
        "ClusterId": "clusterAdmin",
        "Match": {
          "Hosts": [ "admin.razmanager.localhost" ]
        }
      },
      "routeApp": {
        "ClusterId": "clusterApp",
        "Match": {
          "Hosts": [ "app.razmanager.localhost" ]
        }
      },
      "routeDevice": {
        "ClusterId": "clusterDevice",
        "Match": {
          "Hosts": [ "device.razmanager.localhost" ]
        },
        "Transforms": [
          { "ClientCert": "X-Client-Cert" }
        ]
      },
      "routeWeb": {
        "ClusterId": "clusterWeb",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "clusterIdentity": {
        "Destinations": {
          "destination1": {
            "Address": "http://razmanager.identity:8080"
          }
        }
      },
      "clusterAdmin": {
        "Destinations": {
          "destination1": {
            "Address": "http://razmanager.admin:8080"
          }
        }
      },
      "clusterApp": {
        "HttpRequest": {
          "Version": "2",
          "VersionPolicy": "RequestVersionExact",
          "ActivityTimeout": "12:00:00"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://razmanager.app:8080"
          }
        }
      },
      "clusterDevice": {
        "HttpClient": {
          "SslProtocols": [
            "Tls11",
            "Tls12"
          ],
          "MaxConnectionsPerServer": "10",
          "DangerousAcceptAnyServerCertificate": "true"
        },
        "HttpRequest": {
          "Version": "2",
          "VersionPolicy": "RequestVersionExact",
          "ActivityTimeout": "12:00:00"
        },
        "Destinations": {
          "destination1": {
            "Address": "https://razmanager.device:8081"
          }
        }
      }
    }
  }
}