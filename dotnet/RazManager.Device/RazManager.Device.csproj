<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

    <PropertyGroup>
	    <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

	<ItemGroup>
	  <Protobuf Include="../protos/razmanager/protobuf/internal/repository/device_services/device.proto" GrpcServices="Client">
		  <Link>Protos/internal/repository/device_services/device.proto</Link>
		  <ProtoRoot>../protos</ProtoRoot>
	  </Protobuf>
	  <Protobuf Include="../protos/razmanager/protobuf/public/device.service.v1.proto" GrpcServices="Server">
		  <Link>Protos/public/device.service.v1.proto</Link>
		  <ProtoRoot>../protos</ProtoRoot>
	  </Protobuf>
	  <Protobuf Include="../protos/razmanager/protobuf/public/device_configuration.service.v1.proto" GrpcServices="Server">
		  <Link>Protos/public/device_configuration.service.v1.proto</Link>
		  <ProtoRoot>../protos</ProtoRoot>
	  </Protobuf>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.4.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="10.0.2" />
    <PackageReference Include="Microsoft.Orleans.Client" Version="10.0.1" />
    <PackageReference Include="Microsoft.Orleans.Serialization.Protobuf" Version="10.0.1" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Protos\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazManager.Silo.Grains.Abstractions\RazManager.Silo.Grains.Abstractions.csproj" />
    <ProjectReference Include="..\RazManager.Silo.Repository\RazManager.Silo.Repository.csproj" />
    <ProjectReference Include="..\RazManager.Utilities.AspNetCoreGrpc\RazManager.Utilities.AspNetCoreGrpc.csproj" />
    <ProjectReference Include="..\RazManager.Utilities.Grpc\RazManager.Utilities.Grpc.csproj" />
    <ProjectReference Include="..\RazManager.Utilities.Host\RazManager.Utilities.Host.csproj" />
  </ItemGroup>

</Project>
