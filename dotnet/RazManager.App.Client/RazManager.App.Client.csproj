<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.26.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.61.0" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

	<ItemGroup>
		<Protobuf Include="../../Protos/razmanager/protobuf/internal/repository/crud_services/common.proto" GrpcServices="None">
			<Link>Protos/internal/repository/crud_services/common.proto</Link>
			<ProtoRoot>../../Protos</ProtoRoot>
		</Protobuf>
		<Protobuf Include="../../Protos/razmanager/protobuf/internal/repository/crud_services/car_tag.proto" GrpcServices="Client">
			<Link>Protos/internal/repository/crud_services/car_tag.proto</Link>
			<ProtoRoot>../../Protos</ProtoRoot>
		</Protobuf>
		<Protobuf Include="../../Protos/razmanager/protobuf/internal/repository/crud_services/user.proto" GrpcServices="Client">
			<Link>Protos/internal/repository/crud_services/user.proto</Link>
			<ProtoRoot>../../Protos</ProtoRoot>
		</Protobuf>
	</ItemGroup>

</Project>
