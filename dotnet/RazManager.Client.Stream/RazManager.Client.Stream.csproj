<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazManager.Silo.Grains.Abstractions\RazManager.Silo.Grains.Abstractions.csproj" />
  </ItemGroup>

	<ItemGroup>
		<Protobuf Include="../protos/razmanager/protobuf/internal/silo/user_services/device_configuration.proto" GrpcServices="Client">
			<Link>Protos/internal/silo/user_services/device_configuration.proto</Link>
			<ProtoRoot>../protos</ProtoRoot>
		</Protobuf>
	</ItemGroup>


</Project>
